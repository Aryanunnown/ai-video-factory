generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model VideoJob {
  id         String   @id @default(cuid())
  topic      String
  title      String?
  status     String   @default("PENDING")
  scriptJson Json?
  audioUrl   String?
  finalVideo String?
  createdAt  DateTime @default(now())
  notes        String?
  errorMessage String?
  scenes       Scene[]
}

model Scene {
  id          String      @id @default(cuid())
  jobId       String
  text        String
  visual      String
  duration    Int
  orderNo     Int
  status      String      @default("PENDING")
  audioUrl    String?
  voiceStatus VoiceStatus @default(PENDING)
  imageStatus ImageStatus @default(PENDING)
  imageUrl    String?
  videoJob    VideoJob    @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

enum ImageStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum VoiceStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}
